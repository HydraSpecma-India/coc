# ─────────────────────────────────────────────────────────────────────────────
# COC Platform – environment variables
# Copy to .env.local for development. In Vercel set these under
# Project → Settings → Environment Variables. NEVER commit real values.
# Only variables prefixed NEXT_PUBLIC_ reach the browser – none of them are secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=HSIN COC Platform
# Public URL (Vercel: https://coc.yourdomain.com or https://<deployment>.vercel.app)
APP_URL=http://localhost:3000

# ── Auth.js (next-auth v5) ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Required behind Vercel reverse proxy
AUTH_TRUST_HOST=true

# Microsoft Entra ID (user sign-in, OIDC). Redirect URI to register:
#   {APP_URL}/api/auth/callback/microsoft-entra-id
# Application (client) ID of the sign-in app registration
AUTH_MICROSOFT_ENTRA_ID_ID=
# Client secret
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Bootstrap admins (comma separated emails). Used only when the user has no
# Entra app role and no role stored in the users table.
ADMIN_EMAILS=manigandan.parthasarathi@hydraspecma.com

# Development only: when true AND NODE_ENV!=production, a "Local dev user"
# sign-in (no password, role picker) is available so the app can be run
# without an Entra tenant. Ignored in production builds.
AUTH_DEV_BYPASS=false

# ── Supabase (server-side only) ──────────────────────────────────────────────
# https://<project-ref>.supabase.co
SUPABASE_URL=
# Not used by browser; kept for tooling
SUPABASE_ANON_KEY=
# SERVER ONLY – full access, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=

# ── D365 Finance & Operations (OData, client-credentials) ────────────────────
# mock | live (mock = built-in sample data, UI shows DEMO badge)
D365_MODE=mock
# https://<env>.operations.dynamics.com
D365_BASE_URL=
D365_TENANT_ID=
D365_CLIENT_ID=
D365_CLIENT_SECRET=
D365_COMPANY=hsin
D365_PRODUCTION_ENTITY=COCProductionDatas
D365_COC_ENTITY=COCDocuments

# ── Microsoft Graph / SharePoint (client-credentials) ────────────────────────
# mock | live (mock = keep PDFs in Supabase Storage only)
STORAGE_MODE=mock
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# hostname,siteCollectionId,siteId (see docs/05-SHAREPOINT-SETUP.md)
SHAREPOINT_SITE_ID=
# b!...
SHAREPOINT_DRIVE_ID=
SHAREPOINT_ROOT_FOLDER=COC

# ── Automation API (Power Automate) ──────────────────────────────────────────
# Long random string; sent as X-Api-Key
AUTOMATION_API_KEY=

# ── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

