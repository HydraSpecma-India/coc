# ─────────────────────────────────────────────────────────────────────────────
# COC Platform – environment variables
# Copy to .env.local for development. In Vercel set these under
# Project → Settings → Environment Variables. NEVER commit real values.
# Only variables prefixed NEXT_PUBLIC_ reach the browser – none of them are secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="HSIN COC Platform"
APP_URL=http://localhost:3000            # public URL (Vercel: https://coc.yourdomain.com)

# ── Auth.js (next-auth v5) ───────────────────────────────────────────────────
AUTH_SECRET=                             # `openssl rand -base64 32`
AUTH_TRUST_HOST=true                     # required behind Vercel's proxy

# Microsoft Entra ID (user sign-in, OIDC). Redirect URI to register:
#   {APP_URL}/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=              # Application (client) ID of the *sign-in* app registration
AUTH_MICROSOFT_ENTRA_ID_SECRET=          # its client secret
AUTH_MICROSOFT_ENTRA_ID_ISSUER=          # https://login.microsoftonline.com/<tenant-id>/v2.0

# Bootstrap admins (comma separated emails). Used only when the user has no
# Entra app role and no role stored in the users table.
ADMIN_EMAILS=manigandan.parthasarathi@hydraspecma.com

# Development only: when true AND NODE_ENV!=production, a "Local dev user"
# sign-in (no password, role picker) is available so the app can be run
# without an Entra tenant. Ignored in production builds.
AUTH_DEV_BYPASS=false

# ── Supabase (server-side only) ──────────────────────────────────────────────
SUPABASE_URL=                            # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=                       # not used by the browser; kept for tooling
SUPABASE_SERVICE_ROLE_KEY=               # SERVER ONLY – full access, bypasses RLS

# ── D365 Finance & Operations (OData, client-credentials) ────────────────────
D365_MODE=mock                           # mock | live   (mock = built-in sample data, UI shows DEMO badge)
D365_BASE_URL=                           # https://<env>.operations.dynamics.com
D365_TENANT_ID=
D365_CLIENT_ID=
D365_CLIENT_SECRET=
D365_COMPANY=hsin
D365_PRODUCTION_ENTITY=COCProductionDatas
D365_COC_ENTITY=COCDocuments

# ── Microsoft Graph / SharePoint (client-credentials) ────────────────────────
STORAGE_MODE=mock                        # mock | live   (mock = keep PDFs in Supabase Storage only)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_ID=                      # hostname,siteCollectionId,siteId  (see docs/05-SHAREPOINT-SETUP.md)
SHAREPOINT_DRIVE_ID=                     # b!…
SHAREPOINT_ROOT_FOLDER=COC

# ── Automation API (Power Automate) ──────────────────────────────────────────
AUTOMATION_API_KEY=                      # long random string; sent as X-Api-Key

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info                           # debug | info | warn | error
